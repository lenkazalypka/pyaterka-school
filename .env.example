# Required in production. Use the public project URL and anon key from Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-production-anon-key

# Server-only. Required by trusted webhook handlers; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-production-service-role-key

# Required in production. Must be the canonical HTTPS origin, without a path.
NEXT_PUBLIC_APP_URL=https://school.example.com

# Required in production. Generate a unique random value of at least 32 characters.
INVITATION_TOKEN_PEPPER=replace-with-at-least-32-random-characters

# Required in production. Use a separate random secret; never expose it to the browser.
RATE_LIMIT_PEPPER=replace-with-another-32-character-random-secret

# Use "resend" in production. "console" is development-only.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=elio <school@example.com>

# Production error monitoring and structured logs.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Production payments.
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# VAT code 1-6 according to the shop's fiscal settings.
YOOKASSA_VAT_CODE=1

# Optional public landing-page video URL.
NEXT_PUBLIC_HERO_VIDEO_URL=

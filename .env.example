# Public Supabase project configuration. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical production origin, e.g. https://school.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only secret used to hash invitation tokens. Use a unique random value >= 32 chars.
INVITATION_TOKEN_PEPPER=replace-with-a-unique-random-secret-at-least-32-characters

# Development only until a real adapter is implemented. Never use console in production.
EMAIL_PROVIDER=console
